# Avow reads zero runtime configuration or secrets from environment variables.
# Keys, payloads, receipts, and expected public keys are passed explicitly via
# Python/TypeScript function arguments or CLI flags (--key, --public-key, --receipt).
# Never store Ed25519 private signing keys in .env files; generate them with:
#   avow keygen --out signing.key   (creates 0600 signing.key + signing.key.pub)

# Optional developer/maintainer environment variables (used only by local tooling):
# UV_PYTHON=3.13
